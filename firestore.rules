rules_version = '2';

// Dán toàn bộ nội dung này vào Firebase Console -> Firestore Database -> Rules -> Publish.
// Nhớ đổi email quản lý bên dưới cho trùng với tài khoản bạn tạo trong Authentication.
service cloud.firestore {
  match /databases/{database}/documents {

    // Quản lý = đăng nhập bằng EMAIL + MẬT KHẨU với đúng email này (không phải đăng nhập Google).
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'longbao123789@gmail.com'
        && request.auth.token.firebase.sign_in_provider == 'password';
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      // Người dùng đọc được hồ sơ của chính mình; quản lý đọc được tất cả
      allow read: if isAdmin() || isOwner(uid);

      // Lần đầu vào: tự tạo hồ sơ của mình, bắt buộc không bị chặn và có 1 lượt vào
      allow create: if isOwner(uid)
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.blocked == false
        && request.resource.data.visits == 1
        && request.resource.data.keys().hasOnly(['name', 'photoURL', 'email', 'blocked', 'visits', 'firstSeen', 'lastSeen'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 80
        && request.resource.data.photoURL is string && request.resource.data.photoURL.size() <= 500
        && request.resource.data.firstSeen == request.time
        && request.resource.data.lastSeen == request.time;

      // Người dùng chỉ được cập nhật lượt vào / lần gần nhất / tên / ảnh, KHÔNG được tự bỏ chặn
      allow update: if isAdmin()
        || (isOwner(uid)
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['lastSeen', 'visits', 'name', 'photoURL'])
            && request.resource.data.visits == resource.data.visits + 1
            && request.resource.data.name is string && request.resource.data.name.size() <= 80
            && request.resource.data.photoURL is string && request.resource.data.photoURL.size() <= 500
            && request.resource.data.lastSeen == request.time);

      allow delete: if isAdmin();
    }

    // Người đang đăng nhập có hồ sơ và không bị chặn
    function notBlocked() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.blocked == false;
    }

    // Quản lý có thể tạm đóng bảng xếp hạng (settings/site.leaderboard == false)
    function leaderboardOpen() {
      return !exists(/databases/$(database)/documents/settings/site)
        || get(/databases/$(database)/documents/settings/site).data.get('leaderboard', true) != false;
    }

    // Bảng cũ có thể chứa điểm giả: không sử dụng và không cho client ghi tiếp.
    match /scores/{uid} { allow read, write: if false; }

    // Điểm lịch sử từ phiên bản đã tắt: chỉ xem/xóa, không cho client ghi.
    // Nếu Functions cũ còn triển khai, Admin SDK vẫn bỏ qua rules này: phải xóa Functions riêng.
    match /secureScores/{uid} {
      allow read: if isAdmin() || isOwner(uid) || (notBlocked() && leaderboardOpen());
      allow create, update: if false;
      allow delete: if isAdmin();
    }

    // Ngân hàng/phiên/lịch sử đề 20 câu đã ngừng; chỉ giữ dữ liệu cũ, không cho client truy cập.
    match /examBank/{id} { allow read, write: if false; }
    match /examSessions/{uid} { allow read, write: if false; }
    match /examResults/{uid}/attempts/{attempt} { allow read, write: if false; }

    // Cài đặt chung của trang (bật/tắt bảo trì). aiWatch/warningLimit chỉ được giữ
    // để các tài liệu settings/site cũ vẫn hợp lệ khi quản lý cập nhật trường khác.
    // Ai cũng đọc được để thấy thông báo bảo trì
    // ngay cả khi chưa đăng nhập; chỉ quản lý được sửa.
    match /settings/{id} {
      allow read: if id == 'site';
      allow write: if id == 'site' && isAdmin()
        && request.resource.data.keys().hasOnly(['maintenance', 'message', 'leaderboard', 'aiWatch', 'warningLimit', 'updatedAt'])
        && request.resource.data.get('aiWatch', false) is bool
        && request.resource.data.get('warningLimit', 3) is int
        && request.resource.data.get('warningLimit', 3) >= 1
        && request.resource.data.get('warningLimit', 3) <= 10;
    }

    // Hoạt động hiện tại của từng người (đang ở trang nào, làm tới câu mấy): chỉ quản lý xem được
    match /presence/{uid} {
      allow read: if isAdmin();

      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['mode', 'topic', 'answered', 'total', 'score', 'name', 'email', 'photoURL', 'ts'])
        && request.resource.data.mode in ['home', 'study', 'practice']
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.name is string && request.resource.data.name.size() <= 80
        && request.resource.data.ts == request.time;

      allow delete: if isAdmin();
    }

    // Đã tắt chia sẻ màn hình: không ai được đọc/ghi tín hiệu WebRTC cũ.
    match /screenShares/{uid} { allow read, write: if false; }

    // Câu sai và lịch sử làm bài của từng người: chỉ chính người đó và quản lý xem được
    match /progress/{uid} {
      allow read: if isAdmin() || isOwner(uid);

      allow create, update: if isOwner(uid) && notBlocked()
        && request.resource.data.keys().hasOnly(['wrong', 'history', 'ts', 'updatedAt'])
        && request.resource.data.wrong is list && request.resource.data.wrong.size() <= 200
        && request.resource.data.history is list && request.resource.data.history.size() <= 30;

      allow delete: if isAdmin();
    }
  }
}
