rules_version = '2';

// Dán toàn bộ nội dung này vào Firebase Console -> Firestore Database -> Rules -> Publish.
// Nhớ đổi email quản lý bên dưới cho trùng với tài khoản bạn tạo trong Authentication.
service cloud.firestore {
  match /databases/{database}/documents {

    // Quản lý = đăng nhập bằng EMAIL + MẬT KHẨU với đúng email này (không phải đăng nhập Google).
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'longbao123789@gmail.com'
        && request.auth.token.firebase.sign_in_provider == 'password';
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      // Người dùng đọc được hồ sơ của chính mình; quản lý đọc được tất cả
      allow read: if isAdmin() || isOwner(uid);

      // Lần đầu vào: tự tạo hồ sơ của mình, bắt buộc không bị chặn và có 1 lượt vào
      allow create: if isOwner(uid)
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.blocked == false
        && request.resource.data.visits == 1;

      // Người dùng chỉ được cập nhật lượt vào / lần gần nhất / tên / ảnh, KHÔNG được tự bỏ chặn
      allow update: if isAdmin()
        || (isOwner(uid)
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['lastSeen', 'visits', 'name', 'photoURL'])
            && request.resource.data.visits == resource.data.visits + 1);

      allow delete: if isAdmin();
    }

    // Người đang đăng nhập có hồ sơ và không bị chặn
    function notBlocked() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.blocked == false;
    }

    // Quản lý có thể tạm đóng bảng xếp hạng (settings/site.leaderboard == false)
    function leaderboardOpen() {
      return !exists(/databases/$(database)/documents/settings/site)
        || get(/databases/$(database)/documents/settings/site).data.get('leaderboard', true) != false;
    }

    // Bảng xếp hạng: mỗi người 1 dòng (tên, ảnh, điểm cao nhất). KHÔNG chứa email.
    match /scores/{uid} {
      // Xem bảng xếp hạng: phải đăng nhập, không bị chặn, và quản lý chưa đóng bảng.
      // Mỗi người luôn đọc được dòng điểm của chính mình.
      allow read: if isAdmin() || isOwner(uid) || (notBlocked() && leaderboardOpen());

      // Mỗi người chỉ ghi được dòng của chính mình, điểm trong khoảng 0-10
      allow create, update: if isOwner(uid) && notBlocked()
        && request.resource.data.keys().hasOnly(['name', 'photoURL', 'best', 'bestAt', 'attempts', 'lastScore', 'lastAt'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 80
        && request.resource.data.photoURL is string && request.resource.data.photoURL.size() <= 500
        && request.resource.data.best is number && request.resource.data.best >= 0 && request.resource.data.best <= 10
        && request.resource.data.lastScore is number && request.resource.data.lastScore >= 0 && request.resource.data.lastScore <= 10
        && request.resource.data.attempts is int && request.resource.data.attempts >= 1;

      // Quản lý xoá điểm (đưa một người ra khỏi bảng xếp hạng)
      allow delete: if isAdmin();
    }

    // Cài đặt chung của trang (bật/tắt bảo trì). Ai cũng đọc được để thấy thông báo bảo trì
    // ngay cả khi chưa đăng nhập; chỉ quản lý được sửa.
    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Hoạt động hiện tại của từng người (đang ở trang nào, làm tới câu mấy): chỉ quản lý xem được
    match /presence/{uid} {
      allow read: if isAdmin();

      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['mode', 'topic', 'answered', 'total', 'score', 'cur', 'ans', 'name', 'email', 'photoURL', 'ts'])
        && request.resource.data.mode in ['home', 'study', 'practice']
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.name is string && request.resource.data.name.size() <= 80
        && request.resource.data.ts == request.time;

      allow delete: if isAdmin();
    }

    // Câu sai và lịch sử làm bài của từng người: chỉ chính người đó và quản lý xem được
    match /progress/{uid} {
      allow read: if isAdmin() || isOwner(uid);

      allow create, update: if isOwner(uid) && notBlocked()
        && request.resource.data.keys().hasOnly(['wrong', 'history', 'ts', 'updatedAt'])
        && request.resource.data.wrong is list && request.resource.data.wrong.size() <= 200
        && request.resource.data.history is list && request.resource.data.history.size() <= 30;

      allow delete: if isAdmin();
    }
  }
}
